# EDITH — environment configuration (copy to .env and fill in)
# Never commit a real .env. See docs/specs/ for architecture context.

# ─── App ──────────────────────────────────────────────────────────────────
ENV=development                      # development | staging | production
LOG_LEVEL=info

# ─── Database (Azure Database for PostgreSQL) ─────────────────────────────
# Local dev uses docker-compose Postgres on host port 5434 (see docker-compose.yml).
DATABASE_URL=postgresql://edith:edith@localhost:5434/edith

# ─── Auth: our session JWTs ───────────────────────────────────────────────
JWT_SECRET=change-me-dev-only
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
TOKEN_ENCRYPTION_KEY=change-me-32-byte-base64   # encrypts OAuth tokens at rest

# ─── Auth: OIDC providers (relying-party credentials) ─────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Extra id_token audiences accepted at login (comma-separated): your Android + iOS
# OAuth client IDs, since native Google Sign-In issues id_tokens with those as aud.
GOOGLE_ALLOWED_AUDIENCES=
# Public origin for OAuth redirect URIs; add {PUBLIC_BASE_URL}/integrations/google/callback
# as an authorized redirect URI in your Google Cloud OAuth client.
PUBLIC_BASE_URL=http://localhost:8000
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=                   # contents of the .p8 (or path via *_FILE)

# ─── Email: Gmail via IMAP (dev path — P2 replaces with OAuth) ────────────
# Lets EDITH READ your inbox. Use a Google **App Password** (Account → Security →
# 2-Step Verification → App passwords), NOT your normal password. Leave blank to
# keep the email tools inert.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
GMAIL_IMAP_HOST=imap.gmail.com

# ─── Voice: ILMU ASR/TTS (managed API) ────────────────────────────────────
ILMU_API_BASE=
ILMU_API_KEY=
ILMU_ASR_MODEL=
ILMU_TTS_MODEL=
ILMU_TTS_VOICE=

# ─── Agent LLM (ILMU default, frontier fallback) ──────────────────────────
LLM_PROVIDER=ilmu                    # ilmu | anthropic | openai
ILMU_LLM_MODEL=
ANTHROPIC_API_KEY=                   # fallback
OPENAI_API_KEY=                      # fallback / optional Realtime A/B harness

# ─── Optional: OpenAI Realtime A/B comparison harness ─────────────────────
ENABLE_REALTIME_HARNESS=false

# ─── Proactivity (P3): scheduler + push ───────────────────────────────────
PROACTIVE_POLL_SECONDS=30
FCM_PROJECT_ID=                      # Firebase project for FCM push (else push is logged)

# ─── WhatsApp Business Cloud API (P4) — EDITH's own number (optional) ──────
# Compliant outbound channel. NOT the Android personal-assist path (on-device).
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0

# ─── Smart home (P5): Home Assistant (optional) ───────────────────────────
HOME_ASSISTANT_URL=                  # e.g. http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=                # a long-lived access token from your HA profile
